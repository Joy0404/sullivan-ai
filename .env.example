# 실제 키나 학생 개인정보를 저장소에 올리지 않습니다.
APP_ENV=development
ANALYSIS_MODE=local-agent-demo
RAW_MEDIA_RETENTION_SECONDS=0
MAX_UPLOAD_VIDEO_BYTES=104857600

# 브라우저 TTS는 별도 키가 필요 없습니다.
TTS_PROVIDER=browser

# 공개 YouTube와 사용자가 별도 동의한 로컬 영상의 실제 분석
# 로컬 원본은 분석 직후 Files API 삭제를 요청하며 서버에 보관하지 않습니다.
GEMINI_API_KEY=
# 공개 체험: 실제 분석·Gemini 대화는 이 체험 코드를 입력한 경우에만 실행됩니다.
# 실제 값은 Railway Variables에만 넣고 저장소에는 올리지 않습니다.
DEMO_ACCESS_CODE=
DEMO_DAILY_LIMIT=3
ALLOWED_SAMPLE_VIDEO_IDS=R0dqsl3Vgns,thJxqtTgSNY
ANALYSIS_TIMEOUT_SECONDS=180
# 선택: 방문자 IP 헤더를 고정할 때만 (예: CF-Connecting-IP)
CLIENT_IP_HEADER=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# 음성 학습 대화에서 다음 행동을 고르는 에이전트 모델
GEMINI_AGENT_MODEL=gemini-2.5-flash

# 선택 사항: 이용 권한이 확인된 공개 영상 링크를 분석하는 외부 서비스
# 응답은 docs/ANALYSIS_PACKAGE.md의 JSON 계약을 따라야 합니다.
LINK_ANALYZER_URL=
LINK_ANALYZER_TOKEN=
