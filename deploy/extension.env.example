# Copy outside version control. Replace IDs/URL before running in production.
SULLIVAN_PRODUCTION=1
SULLIVAN_ROLE_AUTH=1
SULLIVAN_PUBLIC_URL=https://replace-with-your-real-server.example
SULLIVAN_EXTENSION_CLIENTS={"student":"REPLACE_STUDENT_EXTENSION_ID","guardian":"REPLACE_GUARDIAN_EXTENSION_ID"}
SULLIVAN_MIN_EXTENSION_VERSION=0.4.3
SULLIVAN_ACCOUNTS_DB=/app/data/private/accounts.sqlite
SULLIVAN_PERSISTENT_STORAGE=1
WEB_CONCURRENCY=1
# Set 0 to pause new registrations. Accounts do not require administrator codes.
SULLIVAN_SIGNUP_ENABLED=1
