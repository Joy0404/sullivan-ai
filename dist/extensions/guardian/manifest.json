{
  "manifest_version": 3,
  "name": "Sullivan AI 보호자",
  "version": "0.4.9",
  "description": "보호자 전용 분리 개발 버전: 독립 로그인과 강의 자료 연결",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Sullivan AI 보호자 열기",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
