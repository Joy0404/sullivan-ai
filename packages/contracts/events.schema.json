{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sullivan AI Lecture Analysis Package",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "transcript_segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/transcript" },
      "default": []
    },
    "visual_observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual" },
      "default": []
    },
    "passage_text": { "type": ["string", "null"], "maxLength": 300000 },
    "highlighted_texts": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 100,
      "default": []
    },
    "study_guide": {
      "$ref": "#/$defs/studyGuide"
    }
  },
  "$defs": {
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_ms", "end_ms", "text"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "timestamp_ms", "screen_type", "kind", "text"],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "timestamp_ms": { "type": "integer", "minimum": 0 },
        "screen_type": { "enum": ["board", "passage", "slide", "graph", "image"] },
        "kind": { "enum": ["formula", "number", "condition", "highlight", "passage", "graph", "concept", "decoration", "answer"] },
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
        "importance": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "annotation": { "type": ["string", "null"] },
        "metadata": { "type": "object", "default": {} }
      }
    },
    "studyGuide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "string", "maxLength": 6000, "default": "" },
        "concept_map": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20,
          "default": []
        },
        "glossary": {
          "type": "array",
          "maxItems": 40,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["term", "definition"],
            "properties": {
              "term": { "type": "string", "minLength": 1, "maxLength": 120 },
              "definition": { "type": "string", "minLength": 1, "maxLength": 1200 }
            }
          }
        },
        "recall_questions": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 20,
          "default": []
        }
      },
      "default": {}
    }
  }
}
